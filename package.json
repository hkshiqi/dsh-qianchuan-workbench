{
  "name": "dsh-qianchuan-workbench",
  "version": "2.0.0",
  "description": "千川投流工作台（内容模块）：注册到 dsh-workbench-console 工作台框架，提供账户/计划/素材/直播间数据与决策队列",
  "type": "module",
  "license": "MIT",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "qianchuan",
    "千川",
    "投流",
    "workbench",
    "dashboard"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "dsh-workbench-console"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hkshiqi/dsh-qianchuan-workbench.git"
  },
  "homepage": "https://github.com/hkshiqi/dsh-qianchuan-workbench#readme",
  "bugs": {
    "url": "https://github.com/hkshiqi/dsh-qianchuan-workbench/issues"
  },
  "author": "hkshiqi",
  "dependencies": {
    "dsh-workbench-console": ">=2.0.0"
  }
}
